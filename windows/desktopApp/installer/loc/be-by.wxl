<?xml version="1.0" encoding="utf-8"?>
<!-- The installer in one of Notio's ten languages (D80). The pages of WiX itself come from its own translation of this culture;
     these are the texts of jpackage's pages and ours. NotioLanguage is the language number Windows chooses the texts by. -->
<WixLocalization Culture="be-by" Codepage="1251" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="NotioLanguage">1059</String>
  <!-- The name in "Installed apps" and of the Start menu shortcut (D133): Russian has its own, the others the English one. -->
  <String Id="NotioProductName">Notio by vibic</String>
  <String Id="MainFeatureTitle">Асноўны кампанент</String>
  <String Id="DowngradeErrorMessage">Ужо ўсталявана больш новая версія [ProductName]. Усталяванне больш старой версіі забаронена. Праграма ўсталявання будзе закрыта.</String>
  <String Id="DisallowUpgradeErrorMessage">Ужо ўсталявана больш старая версія [ProductName]. Абнаўленне забаронена. Праграма ўсталявання будзе закрыта.</String>
  <String Id="ShortcutPromptDlg_Title">Усталяванне [ProductName]</String>
  <String Id="ShortcutPromptDlgTitle">{\WixUI_Font_Title}Ярлыкі</String>
  <String Id="ShortcutPromptDlgBannerBitmap">WixUI_Bmp_Banner</String>
  <String Id="ShortcutPromptDlgDescription">Выберыце, якія ярлыкі стварыць.</String>
  <String Id="ShortcutPromptDlgDesktopShortcutControlLabel">Стварыць ярлык на працоўным стале</String>
  <String Id="ShortcutPromptDlgStartMenuShortcutControlLabel">Стварыць ярлык у меню «Пуск»</String>
  <String Id="InstallDirNotEmptyDlg_Title">Усталяванне [ProductName]</String>
  <String Id="InstallDirNotEmptyDlgInstallDirExistMessage">Папка [INSTALLDIR] ужо існуе. Усё роўна ўсталяваць у гэтую папку?</String>
  <String Id="ContextMenuCommandLabel">Адкрыць у [ProductName]</String>
  <String Id="OsConditionMessage">[ProductName] [ProductVersion] не падтрымлівае гэтую версію Windows</String>
  <String Id="LaunchAppCheckbox">Запусціць Notio</String>
</WixLocalization>
