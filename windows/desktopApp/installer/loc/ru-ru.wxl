<?xml version="1.0" encoding="utf-8"?>
<!-- The installer in one of Notio's ten languages (D80). The pages of WiX itself come from its own translation of this culture;
     these are the texts of jpackage's pages and ours. NotioLanguage is the language number Windows chooses the texts by. -->
<WixLocalization Culture="ru-ru" Codepage="1251" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="NotioLanguage">1049</String>
  <!-- The name in "Installed apps" and of the Start menu shortcut (D133): Russian has its own, the others the English one. -->
  <String Id="NotioProductName">Нотио от Вибик</String>
  <String Id="MainFeatureTitle">Основной компонент</String>
  <String Id="DowngradeErrorMessage">Уже установлена более новая версия [ProductName]. Установка более старой версии запрещена. Программа установки будет закрыта.</String>
  <String Id="DisallowUpgradeErrorMessage">Уже установлена более старая версия [ProductName]. Обновление запрещено. Программа установки будет закрыта.</String>
  <String Id="ShortcutPromptDlg_Title">Установка [ProductName]</String>
  <String Id="ShortcutPromptDlgTitle">{\WixUI_Font_Title}Ярлыки</String>
  <String Id="ShortcutPromptDlgBannerBitmap">WixUI_Bmp_Banner</String>
  <String Id="ShortcutPromptDlgDescription">Выберите, какие ярлыки создать.</String>
  <String Id="ShortcutPromptDlgDesktopShortcutControlLabel">Создать ярлык на рабочем столе</String>
  <String Id="ShortcutPromptDlgStartMenuShortcutControlLabel">Создать ярлык в меню «Пуск»</String>
  <String Id="InstallDirNotEmptyDlg_Title">Установка [ProductName]</String>
  <String Id="InstallDirNotEmptyDlgInstallDirExistMessage">Папка [INSTALLDIR] уже существует. Всё равно установить в эту папку?</String>
  <String Id="ContextMenuCommandLabel">Открыть в [ProductName]</String>
  <String Id="OsConditionMessage">[ProductName] [ProductVersion] не поддерживается этой версией Windows</String>
  <String Id="LaunchAppCheckbox">Запустить Notio</String>
</WixLocalization>
