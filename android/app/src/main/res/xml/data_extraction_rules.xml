<?xml version="1.0" encoding="utf-8"?>
<!-- Notio keeps everything on the phone: nothing goes to the cloud backup or to a new phone through the system (D171).
     The person moves data with the app's own Backup (Settings -> Backup). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
